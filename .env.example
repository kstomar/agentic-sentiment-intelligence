# Copy to .env for local development. Never commit real credentials.
# The app starts without keys. Analysis requires both keys to be configured.
APP_ENV=development
LOG_LEVEL=INFO
APP_API_KEY=
# Legacy credentials own only tenant "development"; never enabled in production.
# A business registry requires explicit true to keep this compatibility mode.
DEVELOPMENT_AUTH_ENABLED=true
# Secret JSON arrays; see docs/TENANT_ISOLATION.md. Keep real values private.
TENANT_CREDENTIALS_JSON=
WEBHOOK_INTEGRATIONS_JSON=
TENANT_MAX_CONCURRENT_REQUESTS=4
TENANT_REQUESTS_PER_MINUTE=60
TENANT_MAX_CONCURRENT_INVESTIGATIONS=1
TENANT_MAX_CONCURRENT_MODELS=2
TENANT_MAX_ACTIVE_BATCH_JOBS=1
TENANT_MAX_RETAINED_BATCH_JOBS=5
TENANT_MAX_PENDING_EVENTS=5
TENANT_MAX_CONCURRENT_WEBHOOK_ANALYSES=1
TENANT_MAX_RETAINED_EVENTS=20
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Shared REST ingress: actual-byte limits before parsing, immediate busy rejection.
# Approved intentional compatibility change: JSON above 4 MiB returns HTTP 413.
JSON_MAX_BODY_BYTES=4194304
INGRESS_MAX_CONCURRENT_REQUESTS=16
INGRESS_REQUESTS_PER_MINUTE=120
INGRESS_BODY_TIMEOUT_SECONDS=15
MODEL_MAX_CONCURRENT_CALLS=4
# Legacy development webhook; use WEBHOOK_INTEGRATIONS_JSON for businesses.
# Set a private high-entropy shared secret of at least 32 bytes; never commit it.
WEBHOOK_INTEGRATION_ID=
WEBHOOK_SHARED_SECRET=
WEBHOOK_MAX_BODY_BYTES=16384
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_MAX_PENDING_EVENTS=20
WEBHOOK_MAX_CONCURRENT_ANALYSES=2
WEBHOOK_EVENT_TTL_SECONDS=1800
# Durable direct/webhook feedback + analysis: 0 retains indefinitely.
# Positive expiry must cover at least twice WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS.
INGESTION_RESULT_TTL_SECONDS=0
WEBHOOK_MAX_RETAINED_EVENTS=100
WEBHOOK_PROCESSING_TIMEOUT_SECONDS=60
# Total analysis deadline, including retries and backoff; maximum 120 seconds.
GROQ_TIMEOUT_SECONDS=30
# Retries after the first attempt, transient errors only; maximum 3.
GROQ_MAX_RETRIES=2
# Total investigation deadline across selection, all records, and graph steps.
# Selector uses one attempt; record analysis keeps the bounded T01 retry policy.
INVESTIGATION_TIMEOUT_SECONDS=120
# Local MCP process only; reject excess calls instead of queueing (range 1–8).
MCP_MAX_CONCURRENT_CALLS=2
# Single-process bulk processing; limits include validation reservations.
BATCH_MAX_UPLOAD_BYTES=2097152
BATCH_MAX_RECORDS=100
BATCH_MAX_TEXT_CHARS=5000
BATCH_MAX_ACTIVE_JOBS=3
BATCH_MODEL_CONCURRENCY=2
# T09: 0 retains terminal jobs indefinitely. A positive value explicitly enables deletion.
BATCH_JOB_TTL_SECONDS=0
BATCH_JOB_TIMEOUT_SECONDS=600
BATCH_MAX_RETAINED_JOBS=20
BATCH_MAX_EXTRACTED_BYTES=16777216
# Optional override; docs default to enabled outside production.
# API_DOCS_ENABLED=true
# T09: PostgreSQL/psycopg3 only. Replace placeholders privately; never commit real passwords.
# The project-local socket URL and migration/startup commands are in docs/POSTGRESQL_BATCH_STORAGE.md.
DATABASE_URL=postgresql+psycopg://app_user:REPLACE_WITH_PRIVATE_PASSWORD@127.0.0.1:5432/agentic_sentiment

# T08: disabled by default. Keep Google credentials in private configuration only.
# Fixed HTTPS callback: /api/v1/integrations/gmail/oauth/callback
# See docs/GMAIL_INTEGRATION.md for Google Cloud setup and restricted-scope gates.
GMAIL_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# HTTP is allowed only on localhost, explicitly opted in, outside production.
GMAIL_ALLOW_LOCALHOST_HTTP=false
GMAIL_FEEDBACK_LABEL=customer-feedback
GMAIL_SEARCH_DAYS=7
GMAIL_BUSINESS_TYPE=general
GMAIL_MAX_MESSAGES_PER_IMPORT=20
GMAIL_MAX_MESSAGE_BODY_BYTES=16384
GMAIL_MAX_CONCURRENT_IMPORTS=2
GMAIL_TENANT_MAX_CONCURRENT_IMPORTS=1
GMAIL_MAX_RETAINED_IMPORTS=20
GMAIL_TENANT_MAX_RETAINED_IMPORTS=5
GMAIL_IMPORT_TTL_SECONDS=1800
GMAIL_IMPORT_TIMEOUT_SECONDS=120
GMAIL_OAUTH_STATE_TTL_SECONDS=600
GMAIL_MAX_OAUTH_STATES=64
GMAIL_MAX_CONNECTIONS=33
GMAIL_CONNECTION_TTL_SECONDS=28800
# Persistent metadata quotas; successes do not expire with job TTL.
GMAIL_MAX_DEDUP_RECORDS=10000
GMAIL_TENANT_MAX_DEDUP_RECORDS=1000
# Logical message attempts across jobs/restarts; retries require another import API call.
GMAIL_MESSAGE_MAX_ATTEMPTS=3
GMAIL_MESSAGE_RETRY_DELAY_SECONDS=60
GMAIL_HTTP_TIMEOUT_SECONDS=10
GMAIL_HTTP_MAX_CONCURRENT_CALLS=4
GMAIL_HTTP_MAX_RETRIES=1
GMAIL_MAX_PROVIDER_RESPONSE_BYTES=262144
GMAIL_MAX_LIST_PAGES=5

# For deliberate 1,000-email/100-message imports, see docs/GMAIL_INCREMENTAL_IMPORTS.md.
# Keep normal defaults above unless selecting that bounded bulk profile.
