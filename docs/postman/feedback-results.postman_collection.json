          {
            "key": "X-API-Key",
            "value": "{{api_key}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/ingest/events/{{direct_delivery_id}}/result"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get(\"run_direct_demo\") !== \"true\") pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Direct result retrieved without another inference\", () => pm.response.to.have.status(200));",
              "pm.test(\"Exact original direct analysis\", () => pm.expect(pm.response.json().analysis).to.deep.equal(",
              "  JSON.parse(pm.environment.get(\"direct_analysis\"))));"
            ]
          }
        }
      ]
    }
  ]
}
